# Copy this file to ".env" (same folder) and edit. Never commit .env.

ENVIRONMENT=development

# --- Database -------------------------------------------------------------
# Default: SQLite file (works immediately, no install needed). Leave DATABASE_URL commented out to use it.
# MySQL (create the database first, see README):
# DATABASE_URL=mysql+pymysql://astrokids:YOUR_DB_PASSWORD@localhost:3306/astrokids?charset=utf8mb4

# --- Security -------------------------------------------------------------
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AstroBot AI ----------------------------------------------------------
# AI_PROVIDER: demo (curated answers, no key)  |  openai (any OpenAI-compatible API)  |  anthropic
AI_PROVIDER=demo
AI_API_KEY=
# Optional. Defaults: openai -> gpt-4o-mini, anthropic -> claude-haiku-5-5
AI_MODEL=
# Optional base URL for OpenAI-compatible servers (Groq, OpenRouter, Ollama: http://localhost:11434/v1 ...)
AI_BASE_URL=

# --- NASA open data (Astronomy Picture of the Day on the home page) ---------
# Free key from https://api.nasa.gov (DEMO_KEY works but is heavily rate-limited)
NASA_API_KEY=DEMO_KEY
